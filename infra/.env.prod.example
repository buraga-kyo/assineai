# Modelo do .env de producao, lido pelo docker compose --env-file. Copie para
# um arquivo fora do repositorio e preencha; nada aqui e segredo real.
# Gere cada senha com: openssl rand -hex 32 (so letras e numeros, porque a
# senha da dona entra numa URL postgres:// sem escape).
POSTGRES_DB=assineai
# superusuario postgres do container (so o proprio container usa)
POSTGRES_SENHA=
# roles criadas pelo infra/postgres-init-prod/01-roles.sh no primeiro boot do volume
ASSINEAI_MIGRACAO_SENHA=
ASSINEAI_APP_SENHA=
