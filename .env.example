# Ambiente de desenvolvimento do AssineAi. Copie para .env e ajuste o que precisar.
# Nada aqui é segredo real: os valores casam com infra/compose.dev.yml.

# Aplicação
NODE_ENV=development
PORTA_API=3000
URL_APP=http://localhost:5173
URL_API=http://localhost:3000
# fatal, error, warn, info, debug ou trace
LOG_NIVEL=debug
FUSO_PADRAO=America/Sao_Paulo

# Banco (Postgres 18 com PostGIS, subido por infra/dev.sh)
# a app conecta como assineai_app, sem bypass de RLS
BANCO_URL=postgres://assineai_app:app_dev@localhost:5432/assineai
# as migrations rodam como assineai_migracao, dona do banco
BANCO_URL_MIGRACAO=postgres://assineai_migracao:migracao_dev@localhost:5432/assineai

# Redis (filas do worker)
REDIS_URL=redis://localhost:6379
# quantos PDFs podem ser selados ao mesmo tempo
ASSINATURA_CONCORRENCIA=2

# Armazenamento de arquivos (MinIO em dev, qualquer S3 em produção)
ARMAZENAMENTO_ENDPOINT=http://localhost:9000
ARMAZENAMENTO_REGIAO=us-east-1
ARMAZENAMENTO_BUCKET=assineai
# usuário e senha do MinIO de dev (MINIO_ROOT_USER e MINIO_ROOT_PASSWORD do compose)
ARMAZENAMENTO_CHAVE=assineai
ARMAZENAMENTO_SEGREDO=assineai-dev-segredo
# true para MinIO (endereço no formato endpoint/bucket); false na AWS
ARMAZENAMENTO_CAMINHO_FORCADO=true

# Chaves da aplicação. Gere cada uma com: openssl rand -base64 32
# CHAVE_MESTRA cifra segredos guardados no banco; CHAVE_OTP assina os códigos
# de acesso; CHAVE_ID diz qual chave está em uso, para trocar sem quebrar nada
CHAVE_MESTRA=troque-por-openssl-rand-base64-32
CHAVE_OTP=troque-por-openssl-rand-base64-32
CHAVE_ID=1

# Assinatura de PDF (JSignPdf, Java 21)
JSIGNPDF_JAR=./ferramentas/JSignPdf.jar
JAVA_BIN=java
# certificado da plataforma (PKCS12); a senha fica num arquivo, nunca no argv
CERTIFICADO_PLATAFORMA_ARQUIVO=./certificados/plataforma-dev.pfx
CERTIFICADO_PLATAFORMA_SENHA_ARQUIVO=./certificados/plataforma-dev.senha
CERTIFICADO_PLATAFORMA_ALIAS=assineai
# carimbo do tempo; TSA_URL vazio sela sem carimbo
TSA_URL=http://localhost:3000
TSA_USUARIO=
TSA_SENHA=

# Ferramentas externas: nome no PATH ou caminho completo
OTS_BIN=ots
TYPST_BIN=typst
FONTES_DIR=./fontes

# Canais de envio. Vazios em dev; cada canal entra na própria issue.
TELEGRAM_BOT_TOKEN_PLATAFORMA=
# Evolution API (WhatsApp); o serviço entra no compose junto com o canal
EVOLUTION_URL=http://localhost:8080
EVOLUTION_CHAVE_GLOBAL=
META_APP_ID=
META_APP_SEGREDO=
META_TOKEN_VERIFICACAO=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Email (Mailpit em dev; a caixa fica em http://localhost:8025)
SMTP_URL=smtp://localhost:1025
EMAIL_REMETENTE="AssineAi <nao-responda@assineai.local>"

# Redator de textos: nulo não gera nada; os outros drivers usam as chaves abaixo
REDATOR_DRIVER=nulo
REDATOR_MODELO=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# só com REDATOR_DRIVER=local
REDATOR_LOCAL_URL=

# Limites do produto
LIMITE_UPLOAD_MB=20
OTP_VALIDADE_MIN=30
OTP_TENTATIVAS=5
ENVELOPE_VALIDADE_DIAS=15

# Web (o Vite só enxerga variáveis com prefixo VITE_)
VITE_URL_API=http://localhost:3000
CORS_ORIGENS=http://localhost:5173
