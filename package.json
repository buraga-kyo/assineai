{
  "name": "assineai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "verificar": "pnpm typecheck && pnpm lint && pnpm test && pnpm audit --prod",
    "db:gerar": "pnpm --filter @assineai/api db:gerar",
    "db:migrar": "pnpm --filter @assineai/api db:migrar",
    "db:studio": "pnpm --filter @assineai/api db:studio",
    "db:push": "pnpm --filter @assineai/api db:push",
    "infra:up": "bash infra/dev.sh up",
    "infra:down": "bash infra/dev.sh down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "vue-eslint-parser": "10.4.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0"
    }
  }
}
