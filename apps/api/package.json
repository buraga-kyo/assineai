{
  "name": "@assineai/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json && rm -rf dist/banco/migracoes && cp -r src/banco/migracoes dist/banco/migracoes",
    "start": "node dist/servidor.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:gerar": "drizzle-kit generate",
    "db:migrar": "tsx src/banco/migrar.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "tsx src/banco/push.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "argon2": "0.45.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "vitest": "5.0.0"
  }
}
